# Caddy — sole ingress. Real certs from step-ca ACME (NOT Caddy's self-signed `internal`).
# Every backend is HTTPS on a non-loopback hostname -> satisfies the locality + real-CA gates.
# NOTE: Caddy classifies *.local names as "internal" and would silently fall back to its
# self-signed local CA — so every site imports the explicit step-ca ACME issuer below.

{
	servers {
		protocols h1 h2
	}
}

(internal_acme) {
	tls {
		issuer acme {
			dir https://ca.mnemo.local:9000/acme/acme/directory
			trusted_roots /data/step-ca-root.crt
		}
	}
}

(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	request_body {
		max_size 32MB
	}
}

mcp.mnemo.local {
	import internal_acme
	import secure_headers
	reverse_proxy mnemo-api:8080
}

kc.mnemo.local {
	import internal_acme
	import secure_headers
	# Block the admin console from the public ingress; admin is internal-only.
	@admin path /admin* /metrics*
	respond @admin 404
	reverse_proxy keycloak:8080
}

tei.mnemo.local {
	# model-server hostname (kept stable for the render env); backend is the
	# repo's own embeddings+reranker service on :8000
	import internal_acme
	import secure_headers
	reverse_proxy embedder:8000
}

s3.mnemo.local {
	import internal_acme
	import secure_headers
	reverse_proxy seaweedfs:8333
}

grafana.mnemo.local {
	import internal_acme
	import secure_headers
	reverse_proxy grafana:3000
}
