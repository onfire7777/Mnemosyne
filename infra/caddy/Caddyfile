# Caddy — sole ingress. Real certs from step-ca ACME (NOT Caddy's self-signed `internal`).
# Every backend is HTTPS on a non-loopback hostname -> satisfies the locality + real-CA gates.
# NOTE: Caddy classifies *.local names as "internal" and would silently fall back to its
# self-signed local CA — so every site imports the explicit step-ca ACME issuer below.

{
	servers {
		protocols h1 h2
	}
}

(internal_acme) {
	tls {
		issuer acme {
			dir https://ca.mnemo.local:9000/acme/acme/directory
			trusted_roots /data/step-ca-root.crt
		}
	}
}

(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	request_body {
		max_size 32MB
	}
}

mcp.mnemo.local {
	import internal_acme
	import secure_headers
	# Official MCP SDK StreamableHTTP transport (B3 streamable_http evidence)
	# is served by a separate stateless replica; the JSON-RPC facade handles
	# everything else on this host. handle_path strips the /stream prefix so
	# the SDK app sees its own /mcp path.
	handle_path /stream* {
		reverse_proxy mnemo-stream:8081
	}
	reverse_proxy mnemo-api:8080
}

kc.mnemo.local {
	import internal_acme
	import secure_headers
	# Block the admin console from the public ingress; admin is internal-only.
	@admin path /admin* /metrics*
	respond @admin 404
	reverse_proxy keycloak:8080
}

tei.mnemo.local {
	# model-server hostname (kept stable for the render env); backend is the
	# repo's own embeddings+reranker service on :8000
	import internal_acme
	import secure_headers
	reverse_proxy embedder:8000
}

s3.mnemo.local {
	import internal_acme
	import secure_headers
	reverse_proxy seaweedfs:8333
}

roles.mnemo.local {
	# B4/B9 hosted role provider: engine Http* role adapters + hosted-llm-check
	# reach the role-llm dispatch here over step-ca TLS. Internal net only.
	import internal_acme
	import secure_headers
	reverse_proxy role-http:8791
}

grafana.mnemo.local {
	import internal_acme
	import secure_headers
	reverse_proxy grafana:3000
}

ops.mnemo.local {
	import internal_acme
	import secure_headers
	# Network-tier access control: the rendered ops dashboard artifact is
	# reachable only from the deployment's private ranges (operator bastion,
	# internal services, LAN/VPN ingress); everything else is denied. The
	# artifact is a read-only mount refreshed atomically by mnemo-metrics,
	# so there is no mutation surface.
	@external not remote_ip private_ranges
	respond @external 403
	root * /pub
	file_server
}
