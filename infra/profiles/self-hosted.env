# Mnemosyne — SELF-HOSTED production profile (preferred baseline, no-GPU).
# Non-secret values only. Secrets come from Vault / command providers / *_FILE.
# Copy OUTSIDE the repo, fill, and source before render. See infra/profiles/README.md.
# Uses the shared provider manifest with forbid_local:true retained.
#
# HOST: one non-loopback hostname fronted by Caddy (LAN/VPN). All service URLs are
# HTTPS subdomains of it so they pass the non-loopback + real-CA (step-ca) gates.
#   export MNEMO_HOST=mnemo.local

# ---- operator / evidence identity (render placeholders) ----
MNEMOSYNE_PROD_TENANT=primary
MNEMOSYNE_PROD_OPERATOR_NAME="<operator full name>"
MNEMOSYNE_PROD_OPERATOR_USER="<operator user id>"
MNEMOSYNE_PROD_CHANGE_TICKET="<change ticket id>"
MNEMOSYNE_PROD_RECOMPUTE_CID="<recompute content id>"
MNEMOSYNE_PROD_EVIDENCE_DIR=/secure/outside/repo/mnemo-prod-evidence   # absolute, external, pre-populated
MNEMOSYNE_PROD_C2PA_TOOL=/opt/mnemosyne/bin/c2patool                   # absolute, non-symlinked, external

# ---- TLS (step-ca issued; non-self-signed) ----
MNEMOSYNE_PROD_TLS_HOSTNAME=mnemo.local
MNEMOSYNE_PROD_TLS_URL=https://mnemo.local

# ---- retrieval: NATIVE Postgres (FTS + pgvector HNSW + postgres-recursive-ppr) ----
MNEMOSYNE_POSTGRES_DSN=postgresql://app_user@postgres.mnemo.local:5432/mnemosyne   # login role (member of mnemosyne_app); password via PGPASSFILE
MNEMOSYNE_POSTGRES_CONSOLIDATOR_DSN=postgresql://consolidator_user@postgres.mnemo.local:5432/mnemosyne  # sole-write login; live-probed by postgres-role-check
MNEMOSYNE_POSTGRES_REQUIRE_SAFE_ROLE=1                  # refuse superuser/BYPASSRLS runtime roles
MNEMOSYNE_GRAPH_BACKEND=postgres-recursive-ppr        # non-local NAME; native PPR (NOT Apache AGE)
MNEMOSYNE_LEXICAL_BACKEND=postgres-fts                 # native FTS; switch to paradedb-bm25 ONLY if strict audit demands
MNEMOSYNE_EMBEDDING_DIMS=1024

# ---- models (CPU, via TEI/Infinity behind Caddy) ----
MNEMOSYNE_EMBEDDING_PROVIDER=http
MNEMOSYNE_RETRIEVAL_ALLOWED_INTERNAL_HOSTS=tei.mnemo.local   # embedder/reranker on the internal net resolve private; allow explicitly
MNEMOSYNE_EMBEDDING_URL=https://tei.mnemo.local/embed
MNEMOSYNE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5                      # SLO-proven default (services/embedding, projected 1024-dim); arctic-embed = upgrade option
MNEMOSYNE_RERANKER_URL=https://tei.mnemo.local/rerank
MNEMOSYNE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2         # real cross-encoder (services/embedding); bge-reranker-v2-m3 = upgrade option
# consolidation roles: role-ladder defaults to local Qwen3-4B; frontier is opt-in per role
MNEMOSYNE_PROPOSAL_PROVIDER_CLASS=local
MNEMOSYNE_PROPOSAL_PROVIDER_RETENTION=zero_retention
MNEMOSYNE_PROPOSAL_PROVIDER_REGION=local
MNEMOSYNE_ROLE_LADDER_LOCAL_COMMAND=/opt/mnemosyne/bin/role-llm
MNEMOSYNE_OLLAMA_ALLOWED_INTERNAL_HOSTS=ollama.mnemo.local,localhost,127.0.0.1,::1
MNEMOSYNE_ROLE_LADDER_FRONTIER_ROLES=entity_resolver,lesson_distiller,skill_inducer
MNEMOSYNE_ROLE_LADDER_ALLOW_DETERMINISTIC=0
MNEMOSYNE_SUMMARIZER_PROVIDER=command
MNEMOSYNE_SUMMARIZER_COMMAND=/opt/mnemosyne/bin/role-ladder
MNEMOSYNE_CANDIDATE_EXTRACTOR_PROVIDER=command
MNEMOSYNE_CANDIDATE_EXTRACTOR_COMMAND=/opt/mnemosyne/bin/role-ladder
MNEMOSYNE_ENTITY_RESOLVER_PROVIDER=command
MNEMOSYNE_ENTITY_RESOLVER_COMMAND=/opt/mnemosyne/bin/role-ladder
MNEMOSYNE_LESSON_DISTILLER_PROVIDER=command
MNEMOSYNE_LESSON_DISTILLER_COMMAND=/opt/mnemosyne/bin/role-ladder
MNEMOSYNE_SKILL_INDUCER_PROVIDER=command
MNEMOSYNE_SKILL_INDUCER_COMMAND=/opt/mnemosyne/bin/role-ladder

# ---- identity / OIDC: Keycloak ----
MNEMOSYNE_PROVIDER_OIDC_ISSUER=https://kc.mnemo.local/realms/mnemosyne
MNEMOSYNE_PROVIDER_OIDC_AUDIENCE=mnemosyne-cli   # matches the client in infra/keycloak/realm-mnemosyne.json
MNEMOSYNE_PROVIDER_OIDC_JWKS_URL=https://kc.mnemo.local/realms/mnemosyne/protocol/openid-connect/certs
MNEMOSYNE_PROVIDER_OIDC_AUTHZ_POLICY_FILE=/etc/mnemosyne/authz-policy.json   # MFA-gated operator/tier-0 rules
MNEMOSYNE_PROD_IDP_ISSUER=https://kc.mnemo.local/realms/mnemosyne
MNEMOSYNE_PROD_IDP_AUDIENCE=mnemosyne-cli
MNEMOSYNE_PROD_IDP_JWKS_URL=https://kc.mnemo.local/realms/mnemosyne/protocol/openid-connect/certs
MNEMOSYNE_PROD_IDP_EXPECTED_KID_SHA256="<sha256 hex of the realm signing kid>"   # pins JWKS to the expected signing key

# ---- secrets / KMS: Vault transit (command-backed) ----
MNEMOSYNE_SESSION_SECRET_COMMAND=/opt/mnemosyne/bin/vault-session-secret
MNEMOSYNE_OBJECT_KEY_COMMAND=/opt/mnemosyne/bin/vault-object-key      # per-tenant transit keys
MNEMOSYNE_VAULT_ALLOWED_INTERNAL_HOSTS=vault.mnemo.local,localhost,127.0.0.1,::1

# ---- object store: encrypted volume path (the engine's store is filesystem-backed;
# ---- AES-GCM with Vault-wrapped per-object keys = the real at-rest custody).
# ---- SeaweedFS stays in the stack for S3-consuming tooling; a native S3 adapter is a future seam.
MNEMOSYNE_OBJECT_STORE=/data/objects
MNEMOSYNE_OBJECT_STORE_ENCRYPTION=aesgcm                              # refuse-to-start if 'none' while S2+ writable
MNEMOSYNE_OBJECT_KEY_PROVIDER=command

# ---- MCP runtime (hosted, signed sessions MANDATORY) ----
MNEMOSYNE_MCP_PRODUCTION_PROFILE=1
MNEMOSYNE_MCP_REQUIRE_SESSION=1
MNEMOSYNE_PROD_MCP_HTTP_BASE_URL=https://mcp.mnemo.local
MNEMOSYNE_PROD_MCP_HTTP_HEALTH_URL=https://mcp.mnemo.local/health
MNEMOSYNE_PROD_MCP_HTTP_RPC_URL=https://mcp.mnemo.local/rpc
MNEMOSYNE_PROD_MCP_STREAMABLE_HTTP_BASE_URL=https://mcp.mnemo.local
MNEMOSYNE_PROD_MCP_STREAMABLE_HTTP_HEALTH_URL=https://mcp.mnemo.local/health
MNEMOSYNE_PROD_MCP_STREAMABLE_HTTP_URL=https://mcp.mnemo.local/stream

# ---- observability: Grafana (hosted_url) ----
MNEMOSYNE_PROD_DASHBOARD_URL=https://grafana.mnemo.local/d/mnemosyne-ops

# ---- residency: local-only ----
MNEMOSYNE_ALLOWED_RESIDENCIES=local
MNEMOSYNE_REQUIRE_RUNTIME_RESIDENCY=1
MNEMOSYNE_RUNTIME_RESIDENCY=local

# ---- parametric (B9): NOT available no-GPU; left unset here. See cloud.env. ----
# MNEMOSYNE_PARAMETRIC_PROVIDER=   # requires GPU trainer -> cloud profile
