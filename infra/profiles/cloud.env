# Mnemosyne — CLOUD production profile (B9-capable extension).
# Same keys as self-hosted.env; values point at managed/hosted endpoints.
# Use this profile to evidence B9/FR-21 (GPU LoRA / test-time-training) and any
# capability a no-GPU host cannot satisfy. forbid_local:true retained.
#
# Inherit everything from self-hosted.env, then override the deltas below:
#   set -a; . self-hosted.env; . cloud.env; set +a

# ---- B9 / FR-21: real GPU trainer (the reason this profile exists) ----
MNEMOSYNE_PARAMETRIC_PROVIDER=command
MNEMOSYNE_PARAMETRIC_COMMAND=/opt/mnemosyne/bin/cloud-lora-trainer    # non-local GPU trainer adapter
MNEMOSYNE_PARAMETRIC_ADAPTER_KIND=production-lora-command-adapter

# ---- optional higher-quality managed model endpoints (lift the no-GPU embed/role caps) ----
# MNEMOSYNE_EMBEDDING_URL=https://<managed-embeddings>/embed     # e.g. Qwen3-Embedding-class (note: dims change -> pgvector reindex)
# MNEMOSYNE_EMBEDDING_MODEL=<managed-1024-or-matched-dim-model>
# MNEMOSYNE_RERANKER_URL=https://<managed-reranker>/rerank
# role LLM -> command-backed frontier (claude / OpenAI-compatible) for the reasoning ceiling

# ---- managed identity / KMS / object store (optional swaps; keep non-local + real CA) ----
# MNEMOSYNE_PROVIDER_OIDC_ISSUER=https://<managed-idp>/...
# MNEMOSYNE_OBJECT_STORE=s3   # managed S3 with SSE-KMS

# Everything else (retrieval engine, gates, rails) is identical to the self-hosted profile.
# Route managed-backend egress through the SAME network_safety chokepoint (see security architecture).
