MNEMOSYNE_GROUNDED_RUNTIME_BIN="<absolute external runtime base>/${MNEMOSYNE_CANDIDATE_GIT_SHA}/bin"
MNEMOSYNE_ROLE_LADDER_LOCAL_COMMAND="${MNEMOSYNE_GROUNDED_RUNTIME_BIN}/role-llm"
MNEMOSYNE_QUERY_DECOMPOSER_PROVIDER=command
