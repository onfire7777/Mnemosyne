MNEMOSYNE_GROUNDED_READER_COMMAND="${MNEMOSYNE_GROUNDED_RUNTIME_BIN}/role-ladder"
MNEMOSYNE_GROUNDED_MODEL_SELECTOR=qwen3:8b
