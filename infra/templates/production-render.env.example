# Mnemosyne production soak manifest render inputs.
#
# Copy this file outside the repository, fill the blank non-secret values there,
# then source the external copy before running:
#
#   set -a
#   . /secure/path/to/production-render.env
#   set +a
#   infra/scripts/render-production-soak-manifest.sh \
#     --output /secure/path/to/production-soak-manifest.json
#
# Keep raw secrets out of these values. Use runtime environment variables,
# provider files, Vault/KMS/IdP custody, or command-backed providers for tokens,
# private keys, passwords, DSNs, and decrypted secret material.

# Absolute path to the deployed c2patool-compatible executable. This path is
# executed by provenance-trust-check; it is not an evidence input artifact.
export MNEMOSYNE_PROD_C2PA_TOOL=""
export MNEMOSYNE_PROD_CHANGE_TICKET=""
export MNEMOSYNE_PROD_DASHBOARD_URL=""
# Prepared absolute external production input-artifact directory consumed by
# manifest checks. This must not point inside the repository. This is not the
# capture output bundle path; pass that separately as OUT_ROOT to
# infra/scripts/capture-production-evidence.sh.
export MNEMOSYNE_PROD_EVIDENCE_DIR=""
export MNEMOSYNE_PROD_IDP_AUDIENCE=""
export MNEMOSYNE_PROD_IDP_ISSUER=""
export MNEMOSYNE_PROD_IDP_JWKS_URL=""
export MNEMOSYNE_PROD_MCP_HTTP_BASE_URL=""
export MNEMOSYNE_PROD_MCP_HTTP_HEALTH_URL=""
export MNEMOSYNE_PROD_MCP_HTTP_RPC_URL=""
export MNEMOSYNE_PROD_MCP_STREAMABLE_HTTP_BASE_URL=""
export MNEMOSYNE_PROD_MCP_STREAMABLE_HTTP_HEALTH_URL=""
export MNEMOSYNE_PROD_MCP_STREAMABLE_HTTP_URL=""
export MNEMOSYNE_PROD_OPERATOR_NAME=""
export MNEMOSYNE_PROD_OPERATOR_USER=""
export MNEMOSYNE_PROD_RECOMPUTE_CID=""
export MNEMOSYNE_PROD_TENANT=""
export MNEMOSYNE_PROD_TLS_HOSTNAME=""
export MNEMOSYNE_PROD_TLS_URL=""
