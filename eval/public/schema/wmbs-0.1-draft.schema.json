{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wmbs:0.1-draft",
  "title": "Whole-Memory Benchmark Standard common ABI",
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]*$"
    },
    "short_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]*$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "module_id": {
      "enum": [
        "M01", "M02", "M03", "M04", "M05",
        "M06", "M07", "M08", "M09", "M10",
        "M11", "M12", "M13", "M14", "M15",
        "M16", "M17", "M18", "M19", "M20"
      ]
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest_reference": {
      "type": "string",
      "minLength": 73,
      "maxLength": 512,
      "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
    },
    "result_reference": {
      "type": "string",
      "pattern": "^result-v[12]@sha256:[0-9a-f]{64}$"
    },
    "spdx_expression": {
      "enum": [
        "0BSD",
        "Apache-2.0",
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "CC0-1.0",
        "GPL-2.0-only",
        "GPL-2.0-only WITH Classpath-exception-2.0",
        "MIT",
        "MIT OR Apache-2.0",
        "NOASSERTION",
        "NONE",
        "PSF-2.0"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "utc-timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "request_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "run_id",
        "attempt_id",
        "request_id",
        "idempotency_key",
        "sequence",
        "deadline_utc",
        "tenant_id"
      ],
      "properties": {
        "protocol_version": {"const": "wmbs/0.1-draft"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "attempt_id": {"$ref": "#/$defs/identifier"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "idempotency_key": {"$ref": "#/$defs/identifier"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "deadline_utc": {"$ref": "#/$defs/timestamp"},
        "tenant_id": {"$ref": "#/$defs/identifier"},
        "principal_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "negotiate_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_name", "supported_protocol_versions"],
      "properties": {
        "client_name": {"$ref": "#/$defs/short_string"},
        "supported_protocol_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"const": "wmbs/0.1-draft"}
        }
      }
    },
    "create_run_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "module_version", "division", "track", "seed"],
      "properties": {
        "module_id": {"$ref": "#/$defs/module_id"},
        "module_version": {"type": "string", "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "division": {
          "enum": ["COMPONENT-CLOSED", "AGENT-CLOSED", "SYSTEM-OPEN", "HOSTED-OUTCOME"]
        },
        "track": {"enum": ["DEVELOPMENT", "OFFICIAL-UPSTREAM", "ENHANCED-SUCCESSOR"]},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "public_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"$ref": "#/$defs/short_string"}
      }
    },
    "portable_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "content",
        "actor_label",
        "event_time",
        "ingestion_time",
        "content_sha256",
        "public_metadata"
      ],
      "properties": {
        "event_id": {"$ref": "#/$defs/identifier"},
        "content": {"$ref": "#/$defs/nonempty_string"},
        "actor_label": {"$ref": "#/$defs/short_string"},
        "event_time": {"$ref": "#/$defs/timestamp"},
        "ingestion_time": {"$ref": "#/$defs/timestamp"},
        "valid_from": {
          "anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]
        },
        "valid_to": {
          "anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]
        },
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "modality_handle": {
          "anyOf": [{"$ref": "#/$defs/digest_reference"}, {"type": "null"}]
        },
        "public_metadata": {"$ref": "#/$defs/public_metadata"}
      }
    },
    "ingest_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered_events"],
      "properties": {
        "ordered_events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/portable_event"}
        }
      }
    },
    "retrieve_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "observation_time", "top_k"],
      "properties": {
        "query": {"$ref": "#/$defs/nonempty_string"},
        "observation_time": {"$ref": "#/$defs/timestamp"},
        "top_k": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "answer_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "observation_time", "response_mode"],
      "properties": {
        "question": {"$ref": "#/$defs/nonempty_string"},
        "observation_time": {"$ref": "#/$defs/timestamp"},
        "response_mode": {"enum": ["normal", "forced"]}
      }
    },
    "finalize_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {"enum": ["completed", "cancelled"]}
      }
    },
    "negotiate_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "context", "payload"],
      "properties": {
        "operation": {"const": "negotiate"},
        "context": {"$ref": "#/$defs/request_context"},
        "payload": {"$ref": "#/$defs/negotiate_payload"}
      }
    },
    "create_run_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "context", "payload"],
      "properties": {
        "operation": {"const": "create_run"},
        "context": {"$ref": "#/$defs/request_context"},
        "payload": {"$ref": "#/$defs/create_run_payload"}
      }
    },
    "ingest_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "context", "payload"],
      "properties": {
        "operation": {"const": "ingest"},
        "context": {"$ref": "#/$defs/request_context"},
        "payload": {"$ref": "#/$defs/ingest_payload"}
      }
    },
    "retrieve_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "context", "payload"],
      "properties": {
        "operation": {"const": "retrieve"},
        "context": {"$ref": "#/$defs/request_context"},
        "payload": {"$ref": "#/$defs/retrieve_payload"}
      }
    },
    "answer_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "context", "payload"],
      "properties": {
        "operation": {"const": "answer"},
        "context": {"$ref": "#/$defs/request_context"},
        "payload": {"$ref": "#/$defs/answer_payload"}
      }
    },
    "finalize_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "context", "payload"],
      "properties": {
        "operation": {"const": "finalize"},
        "context": {"$ref": "#/$defs/request_context"},
        "payload": {"$ref": "#/$defs/finalize_payload"}
      }
    },
    "server_hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "server_name", "supported_operations"],
      "properties": {
        "protocol_version": {"const": "wmbs/0.1-draft"},
        "server_name": {"$ref": "#/$defs/short_string"},
        "supported_operations": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"enum": ["negotiate", "create_run", "ingest", "retrieve", "answer", "finalize"]}
        }
      }
    },
    "create_run_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "attempt_id", "accepted"],
      "properties": {
        "run_id": {"$ref": "#/$defs/identifier"},
        "attempt_id": {"$ref": "#/$defs/identifier"},
        "accepted": {"type": "boolean"}
      }
    },
    "error_code": {
      "enum": [
        "INVALID_REQUEST",
        "UNSUPPORTED_OPERATION",
        "UNAUTHORIZED",
        "CONFLICT",
        "ORDER_VIOLATION",
        "DEADLINE_EXCEEDED",
        "RESOURCE_LIMIT",
        "DEPENDENCY_UNAVAILABLE",
        "INTERNAL_ERROR"
      ]
    },
    "event_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/error_code"},
        "message": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "ingest_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "outcome", "durability"],
      "properties": {
        "event_id": {"$ref": "#/$defs/identifier"},
        "outcome": {"enum": ["accepted", "deduplicated", "rejected"]},
        "durability": {"enum": ["acknowledged", "not_acknowledged"]},
        "evidence_handle": {
          "anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
        },
        "error": {
          "anyOf": [{"$ref": "#/$defs/event_error"}, {"type": "null"}]
        }
      },
      "oneOf": [
        {
          "properties": {
            "outcome": {"enum": ["accepted", "deduplicated"]},
            "durability": {"const": "acknowledged"},
            "error": {"type": "null"}
          }
        },
        {
          "required": ["error"],
          "properties": {
            "outcome": {"const": "rejected"},
            "durability": {"const": "not_acknowledged"},
            "evidence_handle": {"type": "null"},
            "error": {"$ref": "#/$defs/event_error"}
          }
        }
      ]
    },
    "ingest_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statuses"],
      "properties": {
        "statuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/ingest_status"}
        }
      }
    },
    "retrieval_hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "stable_item_id",
        "content_or_handle",
        "evidence_handles",
        "observed_at",
        "provenance_status"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1, "maximum": 1000},
        "stable_item_id": {"$ref": "#/$defs/identifier"},
        "score": {
          "anyOf": [{"type": "number", "minimum": -9007199254740991, "maximum": 9007199254740991}, {"type": "null"}]
        },
        "content_or_handle": {"$ref": "#/$defs/nonempty_string"},
        "evidence_handles": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "provenance_status": {"enum": ["verified", "unverified", "unavailable"]}
      }
    },
    "retrieval_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hits"],
      "properties": {
        "hits": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/retrieval_hit"}
        }
      }
    },
    "adapter_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"$ref": "#/$defs/short_string"}
      }
    },
    "answer_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abstained",
        "evidence_handles",
        "action_handles",
        "adapter_metadata"
      ],
      "properties": {
        "answer_text": {
          "anyOf": [{"$ref": "#/$defs/nonempty_string"}, {"type": "null"}]
        },
        "abstained": {"type": "boolean"},
        "confidence": {
          "anyOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]
        },
        "evidence_handles": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "action_handles": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "adapter_metadata": {"$ref": "#/$defs/adapter_metadata"}
      },
      "oneOf": [
        {
          "required": ["answer_text"],
          "properties": {
            "answer_text": {"$ref": "#/$defs/nonempty_string"},
            "abstained": {"const": false}
          }
        },
        {
          "properties": {
            "answer_text": {"type": "null"},
            "abstained": {"const": true}
          }
        }
      ]
    },
    "usage_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_calls",
        "tokens",
        "cpu_ms",
        "peak_rss_bytes",
        "disk_bytes",
        "network_bytes",
        "storage_bytes",
        "latency_ms",
        "retries",
        "errors"
      ],
      "properties": {
        "model_calls": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "cpu_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "peak_rss_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "disk_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "network_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "storage_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "latency_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "retries": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "errors": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "finalize_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "attempt_id", "finalized", "output_sha256", "usage"],
      "properties": {
        "run_id": {"$ref": "#/$defs/identifier"},
        "attempt_id": {"$ref": "#/$defs/identifier"},
        "finalized": {"type": "boolean"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "usage": {"$ref": "#/$defs/usage_receipt"}
      }
    },
    "negotiate_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "payload"],
      "properties": {
        "operation": {"const": "negotiate"},
        "payload": {"$ref": "#/$defs/server_hello"}
      }
    },
    "create_run_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "payload"],
      "properties": {
        "operation": {"const": "create_run"},
        "payload": {"$ref": "#/$defs/create_run_receipt"}
      }
    },
    "ingest_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "payload"],
      "properties": {
        "operation": {"const": "ingest"},
        "payload": {"$ref": "#/$defs/ingest_receipt"}
      }
    },
    "retrieve_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "payload"],
      "properties": {
        "operation": {"const": "retrieve"},
        "payload": {"$ref": "#/$defs/retrieval_envelope"}
      }
    },
    "answer_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "payload"],
      "properties": {
        "operation": {"const": "answer"},
        "payload": {"$ref": "#/$defs/answer_envelope"}
      }
    },
    "finalize_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "payload"],
      "properties": {
        "operation": {"const": "finalize"},
        "payload": {"$ref": "#/$defs/finalize_receipt"}
      }
    },
    "error_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retriable", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/error_code"},
        "retriable": {"type": "boolean"},
        "message": {"$ref": "#/$defs/nonempty_string"},
        "details_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "error_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {"$ref": "#/$defs/error_envelope"}
      }
    },
    "chunking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "overlap"],
      "properties": {
        "size": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "overlap": {"type": "integer", "minimum": 0, "maximum": 999999}
      }
    },
    "index_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric"],
      "properties": {
        "metric": {"enum": ["cosine", "dot", "euclidean", "exact"]}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_seconds", "memory_bytes"],
      "properties": {
        "wall_time_seconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "memory_bytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "AdapterContract": {
      "$anchor": "AdapterContract",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "artifact_sha256",
        "adapter_schema_id",
        "protocol_id",
        "operations",
        "error_codes",
        "deadline_semantics",
        "retry_semantics",
        "idempotency_semantics",
        "ordering_semantics",
        "state_transition_semantics"
      ],
      "properties": {
        "schema_id": {"const": "urn:wmbs:0.1-draft#AdapterContract"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_schema_id": {"$ref": "#/$defs/digest_reference"},
        "protocol_id": {"const": "wmbs/0.1-draft"},
        "operations": {
          "const": ["negotiate", "create_run", "ingest", "retrieve", "answer", "finalize"]
        },
        "error_codes": {
          "const": [
            "INVALID_REQUEST",
            "UNSUPPORTED_OPERATION",
            "UNAUTHORIZED",
            "CONFLICT",
            "ORDER_VIOLATION",
            "DEADLINE_EXCEEDED",
            "RESOURCE_LIMIT",
            "DEPENDENCY_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "deadline_semantics": {"const": "first-response-before-deadline"},
        "retry_semantics": {"const": "fresh-key-after-closed-error"},
        "idempotency_semantics": {"const": "identical-replay"},
        "ordering_semantics": {"const": "strictly-increasing-sequence"},
        "state_transition_semantics": {"const": "response-committed"}
      }
    },
    "DataSourceContract": {
      "$anchor": "DataSourceContract",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "artifact_sha256",
        "source_kind",
        "source_id",
        "schema_ref",
        "seed_domain",
        "golden_fixture_refs",
        "license_id",
        "redistribution"
      ],
      "properties": {
        "schema_id": {"const": "urn:wmbs:0.1-draft#DataSourceContract"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "source_kind": {"enum": ["pinned-dataset", "deterministic-synthetic"]},
        "source_id": {"$ref": "#/$defs/digest_reference"},
        "schema_ref": {"$ref": "#/$defs/digest_reference"},
        "seed_domain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
        },
        "golden_fixture_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest_reference"}
        },
        "license_id": {"$ref": "#/$defs/nonempty_string"},
        "redistribution": {"enum": ["allowed", "restricted", "prohibited"]}
      }
    },
    "ScorerContract": {
      "$anchor": "ScorerContract",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "artifact_sha256",
        "scorer_id",
        "executable_argv",
        "golden_vector_refs",
        "numeric_precision",
        "canonicalization",
        "failure_exit_codes"
      ],
      "properties": {
        "schema_id": {"const": "urn:wmbs:0.1-draft#ScorerContract"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "scorer_id": {"$ref": "#/$defs/digest_reference"},
        "executable_argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/short_string"}
        },
        "golden_vector_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest_reference"}
        },
        "numeric_precision": {"const": "finite-json"},
        "canonicalization": {"const": "sorted-compact-utf8"},
        "failure_exit_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 255,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 255}
        }
      }
    },
    "BaselineManifest": {
      "$anchor": "BaselineManifest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "artifact_sha256",
        "tokenizer",
        "chunking",
        "embedding_model",
        "index_parameters",
        "top_k",
        "prompt_ref",
        "context_order",
        "truncation",
