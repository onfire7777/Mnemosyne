{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wmbs:m08:operation:0.1",
  "title": "M08 module-local operation contract; no execution or admission grant",
  "$defs": {
    "selector": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "branch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "source_handles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      },
      "required": [
        "tenant_id",
        "branch_id",
        "source_handles"
      ],
      "additionalProperties": false
    },
    "delete_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "wmbs-m08-operation/v0.1"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "kind": {
          "const": "delete-request"
        },
        "mode": {
          "const": "reversible"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "adapter_id",
        "adapter_version",
        "selector",
        "kind",
        "mode"
      ],
      "additionalProperties": false
    },
    "delete_receipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "wmbs-m08-operation/v0.1"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "kind": {
          "const": "delete-receipt"
        },
        "mode": {
          "const": "reversible"
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "aborted",
            "unsupported"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "adapter_id",
        "adapter_version",
        "selector",
        "kind",
        "mode",
        "outcome",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "restore_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "wmbs-m08-operation/v0.1"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "kind": {
          "const": "restore-request"
        },
        "delete_receipt": {
          "allOf": [
            {
              "$ref": "#/$defs/delete_receipt"
            },
            {
              "properties": {
                "outcome": {
                  "const": "completed"
                }
              }
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "adapter_id",
        "adapter_version",
        "selector",
        "kind",
        "delete_receipt"
      ],
      "additionalProperties": false
    },
    "restore_receipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "wmbs-m08-operation/v0.1"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "kind": {
          "const": "restore-receipt"
        },
        "delete_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "aborted",
            "unsupported"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "adapter_id",
        "adapter_version",
        "selector",
        "kind",
        "delete_operation_id",
        "outcome",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/delete_request"
    },
    {
      "$ref": "#/$defs/delete_receipt"
    },
    {
      "$ref": "#/$defs/restore_request"
    },
    {
      "$ref": "#/$defs/restore_receipt"
    }
  ]
}
