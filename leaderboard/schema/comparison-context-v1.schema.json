{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmembench.comparison-context/v1",
  "title": "Digest-bound declared comparison context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_digest",
    "protocol_digest",
    "preprocessing_digest",
    "scorer_digest",
    "model_policy_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "openmembench.comparison-context/v1"
    },
    "dataset_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "protocol_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "preprocessing_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scorer_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model_policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
