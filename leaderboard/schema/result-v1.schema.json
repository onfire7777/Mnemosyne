{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mnemosyne.leaderboard.result/v1",
  "title": "Mnemosyne public leaderboard result v1",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "system",
    "track",
    "benchmark",
    "benchmark_version",
    "run_commit",
    "build_fingerprint",
    "config_digest",
    "bundle_digest",
    "trace_index_digest",
    "metrics",
    "publication",
    "operator_entry",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": "mnemosyne.leaderboard.result/v1"
    },
    "record_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "system": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "track": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "benchmark": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "benchmark_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "run_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "build_fingerprint": {
      "$ref": "#/$defs/sha256Digest"
    },
    "config_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "bundle_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "trace_index_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "publication": {
      "type": "object",
      "required": [
        "publishable",
        "label"
      ],
      "properties": {
        "publishable": {
          "type": "boolean"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "register_b_satisfied": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "const": "neutral"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "properties": {
              "register_b_satisfied": {
                "const": true
              }
            },
            "required": [
              "register_b_satisfied"
            ]
          }
        }
      ]
    },
    "operator_entry": {
      "type": "object",
      "required": [
        "operator",
        "disclosed"
      ],
      "properties": {
        "operator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "disclosed": {
          "const": true
        }
      }
    },
    "history": {
      "type": "object",
      "$comment": "The standard-library validator rejects self-supersession.",
      "required": [
        "supersedes"
      ],
      "properties": {
        "supersedes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nonEmptyString"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "track": {
            "const": "development"
          }
        },
        "required": [
          "track"
        ]
      },
      "then": {
        "properties": {
          "publication": {
            "properties": {
              "publishable": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "confidenceInterval": {
      "type": "object",
      "$comment": "The standard-library validator additionally enforces low <= high.",
      "required": [
        "low",
        "high"
      ],
      "properties": {
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        }
      }
    },
    "judge": {
      "type": "object",
      "required": [
        "model",
        "prompt_digest",
        "config_digest"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "prompt_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "config_digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "metric": {
      "type": "object",
      "required": [
        "name",
        "family",
        "value",
        "unit",
        "confidence_interval"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "family": {
          "enum": [
            "retrieval",
            "judged_qa"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "confidence_interval": {
          "$ref": "#/$defs/confidenceInterval"
        },
        "judge": {
          "$ref": "#/$defs/judge"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "const": "judged_qa"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "required": [
              "judge"
            ]
          },
          "else": {
            "not": {
              "required": [
                "judge"
              ]
            }
          }
        }
      ]
    }
  }
}
