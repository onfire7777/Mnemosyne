{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mnemosyne.leaderboard.result/v2",
  "title": "Mnemosyne public leaderboard result v2",
  "$comment": "Additive successor to result-v1. build_fingerprint=sha256(build.json), config_digest=sha256(config.json), bundle_digest=sha256(bundle-manifest.json), trace_index_digest=sha256(traces.jsonl). Atomic rows never carry cross-attempt aggregates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "system",
    "track",
    "benchmark",
    "benchmark_version",
    "run_commit",
    "build_fingerprint",
    "config_digest",
    "bundle_digest",
    "trace_index_digest",
    "metrics",
    "publication",
    "operator_entry",
    "history",
    "module_id",
    "admission_state",
    "evidence_level",
    "track_kind",
    "lineage",
    "identity",
    "division",
    "capability",
    "safety_gates",
    "resources",
    "run_profile",
    "custody",
    "signer_role",
    "trace_id",
    "attempt_outcome"
  ],
  "properties": {
    "schema_version": {
      "const": "mnemosyne.leaderboard.result/v2"
    },
    "record_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "system": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "track": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "benchmark": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "benchmark_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "run_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "build_fingerprint": {
      "$ref": "#/$defs/sha256Digest"
    },
    "config_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "bundle_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "trace_index_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "operator_entry": {
      "$ref": "#/$defs/operator_entry"
    },
    "history": {
      "$ref": "#/$defs/history"
    },
    "module_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "admission_state": {
      "$ref": "#/$defs/admission_state"
    },
    "evidence_level": {
      "$ref": "#/$defs/evidence_level"
    },
    "track_kind": {
      "$ref": "#/$defs/track_kind"
    },
    "lineage": {
      "type": "object"
    },
    "identity": {
      "$ref": "#/$defs/atomic_identity"
    },
    "division": {
      "$ref": "#/$defs/division"
    },
    "capability": {
      "enum": ["native", "emulated", "unsupported"]
    },
    "safety_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/safety_gate"
      }
    },
    "resources": {
      "$ref": "#/$defs/resources"
    },
    "run_profile": {
      "$ref": "#/$defs/run_profile"
    },
    "custody": {
      "enum": [
        "development-public",
        "operator-held-out",
        "certification-held-out"
      ]
    },
    "signer_role": {
      "enum": ["operator", "independent", "custodian"]
    },
    "trace_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "attempt_outcome": {
      "$ref": "#/$defs/attempt_outcome"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "track_kind": {
            "const": "DEVELOPMENT"
          }
        },
        "required": ["track_kind"]
      },
      "then": {
        "properties": {
          "publication": {
            "properties": {
              "publishable": { "const": false },
              "pbpp_headline_eligible": { "const": false }
            }
          },
          "lineage": {
            "type": "object",
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track_kind": {
            "const": "OFFICIAL-UPSTREAM"
          }
        },
        "required": ["track_kind"]
      },
      "then": {
        "properties": {
          "lineage": {
            "$ref": "#/$defs/official_lineage"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track_kind": {
            "const": "ENHANCED-SUCCESSOR"
          }
        },
        "required": ["track_kind"]
      },
      "then": {
        "properties": {
          "lineage": {
            "$ref": "#/$defs/successor_lineage"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admission_state": {
            "enum": [
              "RUN-READY-OFFICIAL-LOCAL",
              "RUN-READY-HOSTED-X",
              "RUN-READY-P32-OPS"
            ]
          }
        },
        "required": ["admission_state"]
      },
      "then": {
        "properties": {
          "evidence_level": { "const": "PUBLICLY_MEASURED" }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "track_kind": {
      "enum": [
        "OFFICIAL-UPSTREAM",
        "ENHANCED-SUCCESSOR",
        "DEVELOPMENT"
      ]
    },
    "admission_state": {
      "enum": [
        "PROPOSED",
        "CONTRACT-READY",
        "PILOT-READY-DEV",
        "RUN-READY-OFFICIAL-LOCAL",
        "RUN-READY-HOSTED-X",
        "RUN-READY-P32-OPS",
        "DEFERRED",
        "DEFERRED-CONFLICT",
        "UNSUPPORTED-BY-SYSTEM",
        "REJECTED"
      ]
    },
    "evidence_level": {
      "enum": [
        "DESIGN_ONLY",
        "IMPLEMENTED",
        "INTERNALLY_MEASURED",
        "PUBLICLY_MEASURED"
      ]
    },
    "division": {
      "enum": [
        "COMPONENT-CLOSED",
        "AGENT-CLOSED",
        "SYSTEM-OPEN",
        "HOSTED-OUTCOME"
      ]
    },
    "attempt_outcome": {
      "enum": [
        "measured",
        "missing",
        "unsupported",
        "failed",
        "aborted",
        "not-measured"
      ]
    },
    "atomic_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "system_version",
        "adapter_id",
        "adapter_version",
        "track_kind",
        "benchmark_id",
        "benchmark_version",
        "module_id",
        "division",
        "resource_profile",
        "backend_id",
        "hardware_fingerprint",
        "model_policy_id",
        "dataset_split_digest",
        "run_id",
        "attempt_id",
        "seed"
      ],
      "properties": {
        "system_id": { "$ref": "#/$defs/nonEmptyString" },
        "system_version": { "$ref": "#/$defs/nonEmptyString" },
        "adapter_id": { "$ref": "#/$defs/nonEmptyString" },
        "adapter_version": { "$ref": "#/$defs/nonEmptyString" },
        "track_kind": { "$ref": "#/$defs/track_kind" },
        "benchmark_id": { "$ref": "#/$defs/nonEmptyString" },
        "benchmark_version": { "$ref": "#/$defs/nonEmptyString" },
        "module_id": { "$ref": "#/$defs/nonEmptyString" },
        "division": { "$ref": "#/$defs/division" },
        "resource_profile": { "$ref": "#/$defs/nonEmptyString" },
        "backend_id": { "$ref": "#/$defs/nonEmptyString" },
        "hardware_fingerprint": { "$ref": "#/$defs/sha256Digest" },
        "model_policy_id": { "$ref": "#/$defs/nonEmptyString" },
        "dataset_split_digest": { "$ref": "#/$defs/sha256Digest" },
        "run_id": { "$ref": "#/$defs/nonEmptyString" },
        "attempt_id": { "$ref": "#/$defs/nonEmptyString" },
        "seed": { "type": "integer" }
      }
    },
    "official_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fidelity"],
      "properties": {
        "fidelity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "upstream_protocol_digest",
            "dataset_digest",
            "split_digest",
            "preprocessing_digest",
            "scorer_digest",
            "environment_digest",
            "revision_digest"
          ],
          "properties": {
            "upstream_protocol_digest": { "$ref": "#/$defs/sha256Digest" },
            "dataset_digest": { "$ref": "#/$defs/sha256Digest" },
            "split_digest": { "$ref": "#/$defs/sha256Digest" },
            "preprocessing_digest": { "$ref": "#/$defs/sha256Digest" },
            "scorer_digest": { "$ref": "#/$defs/sha256Digest" },
            "environment_digest": { "$ref": "#/$defs/sha256Digest" },
            "revision_digest": { "$ref": "#/$defs/sha256Digest" }
          }
        }
      }
    },
    "successor_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_official_record_id",
        "parent_construct_digest",
        "difference_manifest_digest"
      ],
      "properties": {
        "parent_official_record_id": { "$ref": "#/$defs/nonEmptyString" },
        "parent_construct_digest": { "$ref": "#/$defs/sha256Digest" },
        "difference_manifest_digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publishable", "label", "pbpp_headline_eligible"],
      "properties": {
        "publishable": { "type": "boolean" },
        "label": {
          "enum": ["operator-run", "neutral"]
        },
        "register_b_satisfied": { "type": "boolean" },
        "pbpp_headline_eligible": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "label": { "const": "operator-run" } },
            "required": ["label"]
          },
          "then": {
            "properties": { "pbpp_headline_eligible": { "const": false } }
          }
        },
        {
          "if": {
            "properties": { "pbpp_headline_eligible": { "const": true } },
            "required": ["pbpp_headline_eligible"]
          },
          "then": {
            "properties": {
              "label": { "const": "neutral" },
              "register_b_satisfied": { "const": true }
            },
            "required": ["register_b_satisfied"]
          }
        }
      ]
    },
    "operator_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "disclosed"],
      "properties": {
        "operator": { "$ref": "#/$defs/nonEmptyString" },
        "disclosed": { "const": true }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supersedes"],
      "properties": {
        "supersedes": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonEmptyString" }
          ]
        }
      }
    },
    "safety_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "status": {
          "enum": ["passed", "failed", "not-measured"]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treatment"],
      "properties": {
        "treatment": {
          "enum": ["verified", "resource-unverified"]
        },
        "wall_time_ms": { "type": "number" },
        "peak_rss_bytes": { "type": "number" },
        "cost": { "type": "number" },
        "latency_ms": { "type": "number" }
      }
    },
    "run_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "seeds", "retries", "aborts"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/nonEmptyString" },
        "seeds": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "retries": { "type": "integer", "minimum": 0 },
        "aborts": { "type": "integer", "minimum": 0 }
      }
    },
    "confidenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": { "type": "number" },
        "high": { "type": "number" }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt_digest", "config_digest"],
      "properties": {
        "model": { "$ref": "#/$defs/nonEmptyString" },
        "prompt_digest": { "$ref": "#/$defs/sha256Digest" },
        "config_digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "family", "value", "unit", "confidence_interval"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "family": {
          "enum": [
            "retrieval",
            "judged_qa",
            "security",
            "calibration",
            "performance",
            "reproducibility"
          ]
        },
        "value": { "type": "number" },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "confidence_interval": { "$ref": "#/$defs/confidenceInterval" },
        "judge": { "$ref": "#/$defs/judge" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Derived exploratory view. Official and enhanced records cannot share a certified projection. Safety failures are non-averageable.",
      "required": [
        "schema_version",
        "projection_id",
        "kind",
        "source_record_ids",
        "filters",
        "compatibility_key",
        "exclusions",
        "numerator",
        "denominator",
        "uncertainty_method",
        "missing_count",
        "unsupported_count",
        "failed_count",
        "aborted_count",
        "not_measured_count",
        "certified",
        "official",
        "headline",
        "safety_failures_visible"
      ]
    }
  }
}
